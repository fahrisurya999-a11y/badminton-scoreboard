<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="12dp">

    <!-- Top Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvMatchStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GAME 1 (0 - 0)"
            android:textColor="@color/match_point"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSwap"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="🔄 TUKAR"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_pill"
            android:textColor="@color/btn_control_text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:text="↺ RESET"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_pill"
            android:textColor="#EF4444"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Player 1 Card (Blue) -->
    <LinearLayout
        android:id="@+id/cardPlayer1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_player_1"
        android:padding="12dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlayer1Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pemain 1"
                android:textColor="@color/p1_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvServeP1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎾 SERVIS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/serve_active"
                android:background="#1B3A2B"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayer1Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="84sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnP1Minus"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="-"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_pill"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnP1Plus"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="+1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_pill"
                android:textColor="@color/p1_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvP1Games"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Game Menang: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <!-- Player 2 Card (Red) -->
    <LinearLayout
        android:id="@+id/cardPlayer2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_player_2"
        android:padding="12dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlayer2Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pemain 2"
                android:textColor="@color/p2_accent"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvServeP2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎾 SERVIS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/serve_active"
                android:background="#1B3A2B"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="invisible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPlayer2Score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="84sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnP2Minus"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="-"
                android:textSize="22sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_pill"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnP2Plus"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:text="+1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_pill"
                android:textColor="@color/p2_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvP2Games"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Game Menang: 0"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
