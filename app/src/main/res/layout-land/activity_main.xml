<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="8dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvMatchStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TARGET: 30 POIN"
            android:textColor="@color/match_point"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="👥 2 ORANG / SKOR"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_pill"
            android:textColor="#38BDF8"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnSwap"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="🔄 TUKAR LAPANGAN"
            android:textSize="11sp"
            android:background="@drawable/bg_btn_pill"
            android:textColor="@color/btn_control_text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:text="↺ RESET"
            android:textSize="11sp"
            android:background="@drawable/bg_btn_pill"
            android:textColor="#EF4444"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Side-by-Side Players Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <!-- Team 1 Box (Left) -->
        <LinearLayout
            android:id="@+id/cardPlayer1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_player_1"
            android:padding="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- Names in Team 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Orang 1 -->
                <LinearLayout
                    android:id="@+id/rowP1_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvP1_1_Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pemain 1A"
                        android:textColor="@color/p1_accent"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvP1_1_Serve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎾 SERVIS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/serve_active"
                        android:background="#1B3A2B"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <!-- Orang 2 -->
                <LinearLayout
                    android:id="@+id/rowP1_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvP1_2_Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pemain 1B"
                        android:textColor="#7DD3FC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvP1_2_Serve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎾 SERVIS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/serve_active"
                        android:background="#1B3A2B"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlayer1Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="105sp"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnP1Minus"
                    android:layout_width="54dp"
                    android:layout_height="44dp"
                    android:text="-"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_pill"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnP1Plus"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:text="+1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_pill"
                    android:textColor="@color/p1_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvP1Games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Game Menang: 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Net / Center Divider -->
        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Team 2 Box (Right) -->
        <LinearLayout
            android:id="@+id/cardPlayer2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_player_2"
            android:padding="10dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- Names in Team 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Orang 1 -->
                <LinearLayout
                    android:id="@+id/rowP2_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvP2_1_Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pemain 2A"
                        android:textColor="@color/p2_accent"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvP2_1_Serve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎾 SERVIS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/serve_active"
                        android:background="#1B3A2B"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Orang 2 -->
                <LinearLayout
                    android:id="@+id/rowP2_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvP2_2_Name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pemain 2B"
                        android:textColor="#FDA4AF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvP2_2_Serve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎾 SERVIS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/serve_active"
                        android:background="#1B3A2B"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlayer2Score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="105sp"
                android:textStyle="bold"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnP2Minus"
                    android:layout_width="54dp"
                    android:layout_height="44dp"
                    android:text="-"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_pill"
                    android:textColor="@color/text_secondary" />

                <Button
                    android:id="@+id/btnP2Plus"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="14dp"
                    android:text="+1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_pill"
                    android:textColor="@color/p2_accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvP2Games"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Game Menang: 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
